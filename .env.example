# Standalone Clerk authentication and exact browser origins
CORS_ORIGINS=http://localhost:5173
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=polytrade

# Optional: allow AssetHero's separate identity system to call PolyTrade APIs.
# Configure issuer and JWKS together; leave both empty until the integration is enabled.
ASSETHERO_API_ISSUER=
ASSETHERO_API_JWKS_URL=
ASSETHERO_API_AUDIENCE=polytrade

# One existing remote PostgreSQL database and one application setting. All services use it.
# Use the provider's TLS-enabled connection URL; this example value is not deployable.
DATABASE_URL=postgresql://polytrade:replace-me@db.example.com:5432/polytrade?sslmode=require

# Redis carries Celery jobs and short-lived status only; PostgreSQL is authoritative.
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1
BACKTEST_WORKER_CONCURRENCY=2
BACKTEST_MAX_ACTIVE_RUNS_PER_OWNER=10
BACKTEST_MAX_RETRIES=5
BACKTEST_SOFT_TIME_LIMIT_SECONDS=840
BACKTEST_HARD_TIME_LIMIT_SECONDS=900
BACKTEST_VISIBILITY_TIMEOUT_SECONDS=1200
BACKTEST_STALE_SECONDS=960
BACKTEST_OUTBOX_INTERVAL_SECONDS=2
BACKTEST_MAX_POINTS=2000000
POLYMARKET_REQUEST_TIMEOUT_SECONDS=15

# Agent
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GATEWAY_BASE_URL=http://localhost:4000
BACKTEST_BASE_URL=http://localhost:8100
# Exactly 32 ASCII bytes; generate with: openssl rand -hex 16
LANGGRAPH_AES_KEY=
AGENT_HTTP_TIMEOUT_SECONDS=15
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAX_CONCURRENT_RUNS=8
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_THREAD_TTL_DAYS=30
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Gateway
NODE_ENV=development
PORT=4000
AGENT_UPSTREAM_URL=http://localhost:8000
BACKTEST_UPSTREAM_URL=http://localhost:8100
UPSTREAM_PROXY_TIMEOUT_MS=60000
# Generate with: openssl rand -base64 32
CREDENTIALS_KEK_BASE64=
# Optional: bot token for Telegram alert channels (from @BotFather). Leave empty
# until a Telegram alert channel is configured.
TELEGRAM_BOT_TOKEN=
TRUSTED_PROXIES=127.0.0.1/32,::1/128
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_REQUEST_TIMEOUT_MS=10000
WALLET_CHALLENGE_TTL_SECONDS=300
# Idle window slides forward while the tab is visible; absolute caps custody at one day.
WALLET_SESSION_IDLE_SECONDS=14400
WALLET_SESSION_MAX_SECONDS=86400
ORDER_INTENT_TTL_SECONDS=120

# React/Vite standalone Clerk client
VITE_API_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=polytrade
